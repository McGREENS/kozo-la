# Database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# JWT Secret for token signing (make this VERY long and random in production)
# Generate with: openssl rand -base64 32
# The admin user and password are stored in the database, not environment variables
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_make_it_long_and_random
